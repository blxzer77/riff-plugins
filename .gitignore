.DS_Store
__pycache__/
*.pyc
.venv/
.idea/
.vscode/

# Eval workspaces (contain skill snapshots; keep out of git and skill discovery)
.workspace/

# Generic agent install output
.agents/
# ...except inside eval fixtures, where a project-local skill is part of the fixture
!evals/*/files/*/.agents/
agent/

# Agent runtime state
.claude/*.lock
.claude/settings.local.json

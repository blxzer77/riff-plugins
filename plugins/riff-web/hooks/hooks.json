{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "WebSearch|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "riff hook pretooluse --agent claude-code",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "riff hook sessionstart --agent claude-code",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
